<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- FletchTunes queue sync: adb-only setup (QueueSyncDebugReceiver). DUMP is held by the adb shell, not by apps. -->
        <receiver
            android:name="com.metrolist.music.playback.queue.sync.QueueSyncDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- FletchTunes: adb-only timing probe for podcast show pages (PodcastProbeDebugReceiver). -->
        <receiver
            android:name="com.metrolist.music.debug.PodcastProbeDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
